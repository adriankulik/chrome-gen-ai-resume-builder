{
  "manifest_version": 3,
  "name": "LocalResume - On-Device GenAI Resume Builder",
  "short_name": "LocalResume",
  "version": "1.0.0",
  "description": "Provider-agnostic, on-device GenAI resume tailor focused on Chrome's built-in Gemini Nano with support for local runners (Ollama, LM Studio).",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open LocalResume",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html?panel=1"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
